{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Referrer-Policy",
     "value": "no-referrer"
    },
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  }
 ],
 "redirects": [
  {
   "source": "/faces",
   "destination": "/faces/",
   "permanent": false
  },
  {
   "source": "/faces/vs",
   "destination": "/faces/vs/",
   "permanent": false
  },
  {
   "source": "/wayfinder",
   "destination": "/wayfinder/",
   "permanent": false
  }
 ]
}
